[Unit]
Description=Solana Release Alerts Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/solana-release-alerts
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/%i/solana-release-alerts/venv/bin/python -u bot.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
